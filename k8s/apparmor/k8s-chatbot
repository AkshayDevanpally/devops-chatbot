# AppArmor profile for every chatbot pod (loaded on the node by scripts/01a-apparmor.sh).
# Same protections as containerd's default "cri-containerd.apparmor.d" profile, except signals.
# Why: on Ubuntu 25.10+ container processes carry a stacked label ("...//&unconfined"), so the
# default profile's "signal peer=cri-containerd.apparmor.d" rule never matches and a process
# can't signal its own children (Postgres recovery, Ollama, nginx workers all break).
# Allowing signals is safe here: the pod's PID namespace limits what it can reach.
#include <tunables/global>

profile k8s-chatbot flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  signal,

  deny @{PROC}/* w,   # no writes to files directly in /proc
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=k8s-chatbot,
}
